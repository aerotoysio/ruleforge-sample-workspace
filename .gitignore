# Editor-only state
.DS_Store
*.tmp

# Engine-fixture staging — regenerated on every /api/test invocation
.engine-staging/

# Stray npm artifact — this is a data workspace, not a node project
package-lock.json

# Generated SQLite workspace DB (regenerated by `migrate-sqlite`; folders stay
# the source of truth until the editor swap lands)
workspace.db
workspace.db-wal
workspace.db-shm
