{
  "id": "offer-tax",
  "name": "Offer tax — per-pax demo",
  "description": "Iterate over offer.pax. For each pax, look up tax based on the first journey's first bound's first segment (origin, destination, cabin) plus the pax's ageCategory. Returns one tax line per pax. Multi-bound granularity is a follow-up — would wrap the inner sub-graph in an outer iterator over $.offer.journeys[*].bounds[*].",
  "endpoint": "/v1/offer/tax",
  "method": "POST",
  "status": "draft",
  "currentVersion": 1,
  "category": "Tax",
  "tags": [
    "offer",
    "tax",
    "demo"
  ],
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "rules/offer-tax/schema/input.json",
    "title": "OfferTaxRequest",
    "type": "object",
    "required": [
      "offer"
    ],
    "properties": {
      "offer": {
        "type": "object",
        "required": [
          "pax"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "pointOfSale": {
            "type": "string"
          },
          "pax": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "ageCategory"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "ageCategory": {
                  "type": "string",
                  "enum": [
                    "ADT",
                    "CHD",
                    "INF"
                  ]
                }
              }
            }
          },
          "journeys": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "bounds"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "paxIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "bounds": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "segments"
                    ],
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "origin": {
                        "type": "string"
                      },
                      "destination": {
                        "type": "string"
                      },
                      "segments": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": [
                            "id",
                            "origin",
                            "destination",
                            "cabin"
                          ],
                          "properties": {
                            "id": {
                              "type": "string"
                            },
                            "origin": {
                              "type": "string"
                            },
                            "destination": {
                              "type": "string"
                            },
                            "cabin": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "rules/offer-tax/schema/output.json",
    "title": "OfferTaxResponse",
    "type": "array",
    "items": {
      "type": "object",
      "required": [
        "paxId",
        "code",
        "amount",
        "currency"
      ],
      "properties": {
        "paxId": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "amount": {
          "type": "number"
        },
        "currency": {
          "type": "string"
        }
      }
    }
  },
  "contextSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "rules/offer-tax/schema/context.json",
    "title": "OfferTaxContext",
    "description": "Per-evaluation context. The iterator opens a $pax frame; downstream nodes can also write to and read from $ctx.",
    "type": "object",
    "properties": {}
  },
  "nodes": [
    {
      "id": "n1",
      "type": "input",
      "position": {
        "x": 80,
        "y": 240
      },
      "data": {
        "label": "Offer",
        "category": "input",
        "description": null,
        "templateId": "node-input"
      }
    },
    {
      "id": "n2",
      "type": "iterator",
      "position": {
        "x": 280,
        "y": 240
      },
      "data": {
        "label": "For each pax",
        "category": "iterator",
        "description": null,
        "templateId": "node-iterator",
        "config": {
          "source": "$.offer.pax",
          "as": "pax"
        }
      }
    },
    {
      "id": "n3",
      "type": "constant",
      "position": {
        "x": 500,
        "y": 240
      },
      "data": {
        "label": "Tax line shell",
        "category": "constant",
        "description": null,
        "templateId": "node-constant",
        "config": {
          "value": {
            "paxId": "",
            "code": "?",
            "amount": 0,
            "currency": ""
          }
        }
      }
    },
    {
      "id": "n4",
      "type": "mutator",
      "position": {
        "x": 720,
        "y": 240
      },
      "data": {
        "label": "Set paxId",
        "category": "mutator",
        "description": null,
        "templateId": "node-mutator-set",
        "config": {
          "target": "paxId",
          "from": "$pax.id"
        }
      }
    },
    {
      "id": "n5",
      "type": "mutator",
      "position": {
        "x": 940,
        "y": 240
      },
      "data": {
        "label": "Lookup tax code",
        "category": "mutator",
        "description": null,
        "templateId": "node-mutator-lookup",
        "config": {
          "target": "code",
          "lookup": {
            "referenceId": "ref-offer-tax-rates",
            "valueColumn": "code",
            "matchOn": {
              "origin": "$.offer.journeys[0].bounds[0].segments[0].origin",
              "destination": "$.offer.journeys[0].bounds[0].segments[0].destination",
              "cabin": "$.offer.journeys[0].bounds[0].segments[0].cabin",
              "ageCategory": "$pax.ageCategory"
            }
          },
          "onMissing": "leave"
        }
      }
    },
    {
      "id": "n6",
      "type": "mutator",
      "position": {
        "x": 1160,
        "y": 240
      },
      "data": {
        "label": "Lookup amount",
        "category": "mutator",
        "description": null,
        "templateId": "node-mutator-lookup",
        "config": {
          "target": "amount",
          "lookup": {
            "referenceId": "ref-offer-tax-rates",
            "valueColumn": "amount",
            "matchOn": {
              "origin": "$.offer.journeys[0].bounds[0].segments[0].origin",
              "destination": "$.offer.journeys[0].bounds[0].segments[0].destination",
              "cabin": "$.offer.journeys[0].bounds[0].segments[0].cabin",
              "ageCategory": "$pax.ageCategory"
            }
          },
          "onMissing": "leave"
        }
      }
    },
    {
      "id": "n7",
      "type": "mutator",
      "position": {
        "x": 1380,
        "y": 240
      },
      "data": {
        "label": "Lookup currency",
        "category": "mutator",
        "description": null,
        "templateId": "node-mutator-lookup",
        "config": {
          "target": "currency",
          "lookup": {
            "referenceId": "ref-offer-tax-rates",
            "valueColumn": "currency",
            "matchOn": {
              "origin": "$.offer.journeys[0].bounds[0].segments[0].origin",
              "destination": "$.offer.journeys[0].bounds[0].segments[0].destination",
              "cabin": "$.offer.journeys[0].bounds[0].segments[0].cabin",
              "ageCategory": "$pax.ageCategory"
            }
          },
          "onMissing": "leave"
        }
      }
    },
    {
      "id": "n8",
      "type": "merge",
      "position": {
        "x": 1600,
        "y": 240
      },
      "data": {
        "label": "Collect tax lines",
        "category": "merge",
        "description": null,
        "templateId": "node-merge",
        "config": {
          "mode": "collect"
        }
      }
    },
    {
      "id": "n9",
      "type": "output",
      "position": {
        "x": 1820,
        "y": 240
      },
      "data": {
        "label": "Result",
        "category": "output",
        "description": null,
        "templateId": "node-output"
      }
    }
  ],
  "edges": [
