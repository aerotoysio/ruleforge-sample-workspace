{
  "id": "markets-discount",
  "name": "Markets discount — USA except Texas, plus GVA",
  "description": "Apply a $50 discount to bookings whose destination is in a curated market: every airport in the USA except Texas, plus Geneva (GVA). Showcases the markets filter — destination is bound to a 'location' field on the request, the values list is authored as a hierarchical include/exclude.",
  "endpoint": "/v1/discount/markets",
  "method": "POST",
  "status": "draft",
  "currentVersion": 1,
  "category": "Discount",
  "tags": [
    "discount",
    "markets",
    "demo"
  ],
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "rules/markets-discount/schema/input.json",
    "title": "MarketsDiscountRequest",
    "type": "object",
    "required": [
      "booking"
    ],
    "properties": {
      "booking": {
        "type": "object",
        "required": [
          "bookingRef",
          "destination"
        ],
        "properties": {
          "bookingRef": {
            "type": "string",
            "description": "Booking reference / PNR."
          },
          "fareAmount": {
            "type": "number",
            "description": "Total fare before discount, in pointOfSale currency."
          },
          "currency": {
            "type": "string",
            "description": "ISO 4217 currency code, e.g. USD."
          },
          "destination": {
            "type": "object",
            "required": [
              "location"
            ],
            "properties": {
              "location": {
                "type": "string",
                "description": "Destination IATA airport code — the 'location' field the markets filter targets."
              },
              "city": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "rules/markets-discount/schema/output.json",
    "title": "MarketsDiscountResponse",
    "type": "object",
    "required": [
      "bookingRef",
      "discountApplied"
    ],
    "properties": {
      "bookingRef": {
        "type": "string"
      },
      "discountApplied": {
        "type": "boolean"
      },
      "discountAmount": {
        "type": "number",
        "description": "0 when no discount applied."
      },
      "currency": {
        "type": "string"
      },
      "reason": {
        "type": "string",
        "description": "Human-readable note: 'destination in eligible market' / 'destination not in eligible market'."
      }
    }
  },
  "contextSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "rules/markets-discount/schema/context.json",
    "title": "MarketsDiscountContext",
    "type": "object",
    "properties": {}
  },
  "nodes": [
    {
      "id": "n1",
      "type": "input",
      "position": {
        "x": 80,
        "y": 240
      },
      "data": {
        "label": "Booking",
        "category": "input",
        "description": null,
        "templateId": "node-input"
      }
    },
    {
      "id": "n2",
      "type": "filter",
      "position": {
        "x": 320,
        "y": 240
      },
      "data": {
        "label": "Eligible market?",
        "category": "filter",
        "description": null,
        "templateId": "node-filter-markets",
        "config": {
          "source": {
            "kind": "request",
            "path": "$.booking.destination.location"
          },
          "compare": {
            "operator": "in",
            "values": [
              "GVA",
              "JFK",
              "EWR",
              "LGA",
              "BOS",
              "LAX",
              "SFO",
              "SAN",
              "ORD",
              "MDW",
              "MIA",
              "MCO",
              "ATL",
              "SEA",
              "DEN",
              "PHX",
              "LAS"
            ]
          },
          "arraySelector": "any",
          "onMissing": "fail"
        }
      }
    },
    {
      "id": "n3",
      "type": "constant",
      "position": {
        "x": 600,
        "y": 140
      },
      "data": {
        "label": "Discount line",
        "category": "product",
        "description": null,
        "templateId": "node-constant",
        "config": {
          "output": {
            "code": "MARKETS-DISC",
            "amount": 50,
            "currency": "${$.booking.currency}",
            "appliesTo": "fare",
            "reason": "destination in eligible market",
            "paxId": "${$.booking.bookingRef}"
          }
        }
      }
    },
    {
      "id": "n4",
      "type": "constant",
      "position": {
        "x": 600,
        "y": 340
      },
      "data": {
        "label": "No discount",
        "category": "product",
        "description": null,
        "templateId": "node-constant",
        "config": {
          "output": {
            "code": "MARKETS-NOMATCH",
            "amount": 0,
            "currency": "${$.booking.currency}",
            "appliesTo": "fare",
            "reason": "destination not in eligible market",
            "paxId": "${$.booking.bookingRef}"
          }
        }
      }
    },
    {
      "id": "n5",
      "type": "merge",
      "position": {
        "x": 880,
        "y": 240
      },
      "data": {
        "label": "Combine outcomes",
        "category": "merge",
        "description": null,
        "templateId": "node-merge",
        "config": {
          "mode": "first"
        }
      }
    },
    {
      "id": "n6",
      "type": "output",
      "position": {
        "x": 1120,
        "y": 240
      },
      "data": {
        "label": "Result",
        "category": "output",
        "description": null,
        "templateId": "node-output"
      }
    }
  ],
  "edges": [
