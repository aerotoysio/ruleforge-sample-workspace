      "target": "n3",
      "branch": "pass",
      "sourceHandle": "pass",
      "targetHandle": null
    },
    {
      "id": "e3",
      "source": "n2",
      "target": "n4",
      "branch": "fail",
      "sourceHandle": "fail",
      "targetHandle": null
    },
    {
