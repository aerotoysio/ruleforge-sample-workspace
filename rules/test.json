  "aiMeta": {
    "narrative": "The rule reads the flight's departure hour and day of week from the request. It seeds a working object with default values (not eligible, no asset), copies the request's flightHour and flightDayOfWeek onto that object, then computes eligibility: the passenger is eligible when the flight departs on a weekday (Monday–Friday) between 06:00 and 22:00 inclusive. Based on that boolean, it resolves the lounge asset to 'LOUNGE-PASS-001' when eligible or 'NONE' otherwise, and returns both the eligibility flag and the asset.",
    "nodeExplanations": {
      "n2": "Creates the initial working object with default fields: eligible=false, loungeAsset='NONE', and placeholders for flightHour and flightDayOfWeek.",
      "n3": "Copies the request's flightHour and flightDayOfWeek into the working object so they can be used in calculations.",
      "n4": "Evaluates eligibility — true only when the flight day is a weekday (1–5) and the hour is within lounge operating hours (6–22).",
      "n5": "Resolves the lounge asset to grant: 'LOUNGE-PASS-001' if eligible, otherwise 'NONE'."
    },
