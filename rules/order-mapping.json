  "aiMeta": {
    "narrative": "The rule receives a PNR JSON (record locator, passengers, segments and optional contact). It first seeds an empty IATA Order envelope with a constant node containing all target fields (OrderID, TypeCode, StatusCode, BookingReferences, Passengers, Flights, Contacts). The mutator-map node then transforms the PNR by copying the record locator into both OrderID and the first BookingReference ID, mapping the passenger array into Order.Passengers, the segment array into Order.Flights, and the contact object into Order.Contacts. A calc node stamps StatusCode to 'Confirmed', completing the IATA-compliant Order, which is returned by the output node.",
    "nodeExplanations": {
      "n1": "Accepts the inbound PNR payload (recordLocator, passengers, segments, optional contact).",
      "n2": "Seeds the working object with a fully-shaped, empty IATA Order envelope so every target field exists before mapping.",
      "n3": "Performs the core transform: copies PNR fields into the corresponding NDC-style Order fields (OrderID, BookingReferences, Passengers, Flights, Contacts).",
      "n4": "Stamps the Order StatusCode to 'Confirmed' to produce a valid Order status."
    },
