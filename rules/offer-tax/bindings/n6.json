{
  "instanceId": "n6",
  "ruleId": "offer-tax",
  "bindings": {
    "target":      { "kind": "literal",   "value": "amount" },
    "referenceId": { "kind": "reference", "referenceId": "ref-offer-tax-rates" },
    "valueColumn": { "kind": "literal",   "value": "amount" },
    "onMissing":   { "kind": "literal",   "value": "leave" }
  },
  "extras": {
    "matchOn": {
      "origin":      { "kind": "path",    "path": "$.offer.journeys[0].bounds[0].segments[0].origin" },
      "destination": { "kind": "path",    "path": "$.offer.journeys[0].bounds[0].segments[0].destination" },
      "cabin":       { "kind": "path",    "path": "$.offer.journeys[0].bounds[0].segments[0].cabin" },
      "ageCategory": { "kind": "context", "key":   "$pax.ageCategory" }
    }
  }
}
