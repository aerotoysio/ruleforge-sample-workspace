{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rules/offer-tax/schema/input.json",
  "title": "OfferTaxRequest",
  "type": "object",
  "required": ["offer"],
  "properties": {
    "offer": {
      "type": "object",
      "required": ["pax"],
      "properties": {
        "id": { "type": "string" },
        "currency": { "type": "string" },
        "pointOfSale": { "type": "string" },
        "pax": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "ageCategory"],
            "properties": {
              "id": { "type": "string" },
              "ageCategory": { "type": "string", "enum": ["ADT", "CHD", "INF"] }
            }
          }
        },
        "journeys": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "bounds"],
            "properties": {
              "id": { "type": "string" },
              "paxIds": { "type": "array", "items": { "type": "string" } },
              "bounds": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "segments"],
                  "properties": {
                    "id": { "type": "string" },
                    "origin": { "type": "string" },
                    "destination": { "type": "string" },
                    "segments": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["id", "origin", "destination", "cabin"],
                        "properties": {
                          "id": { "type": "string" },
                          "origin": { "type": "string" },
                          "destination": { "type": "string" },
                          "cabin": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
