{
  "instanceId": "n3",
  "ruleId": "markets-discount",
  "bindings": {
    "value": {
      "kind": "template-fill",
      "templateId": "tmpl-discount-line",
      "fields": {
        "code":      { "kind": "literal", "value": "MARKETS-DISC" },
        "amount":    { "kind": "literal", "value": 50 },
        "currency":  { "kind": "path",    "path":  "$.booking.currency" },
        "appliesTo": { "kind": "literal", "value": "fare" },
        "reason":    { "kind": "literal", "value": "destination in eligible market" },
        "paxId":     { "kind": "path",    "path":  "$.booking.bookingRef" }
      }
    }
  }
}
